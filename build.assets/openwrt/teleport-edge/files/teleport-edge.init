#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1
PROG=/usr/sbin/teleport-edge
CONF=/etc/teleport.yaml
UCI=/etc/config/teleport-edge

emit_command_arg() {
	echo "        - \"$1\""
}

emit_command() {
	local name period
	config_get name "$1" name
	config_get period "$1" period '1h'
	[ -n "$name" ] || return 0
	if [ "${commands_header:-0}" = 0 ]; then
		echo "  commands:"
		commands_header=1
	fi
	echo "    - name: ${name}"
	echo "      period: ${period}"
	echo "      command:"
	config_list_foreach "$1" argv emit_command_arg
}

generate_yaml() {
	local enabled nodename proxy token data_dir insecure labels
	config_load teleport-edge
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 1
	config_get nodename main nodename "$(uname -n)"
	config_get proxy main proxy
	config_get token main token
	config_get data_dir main data_dir /var/lib/teleport
	config_get_bool insecure main insecure 0
	config_get labels main labels
	mkdir -p "$data_dir" "$(dirname "$CONF")"
	{
		echo "version: v3"
		echo "teleport:"
		echo "  nodename: ${nodename}"
		echo "  data_dir: ${data_dir}"
		echo "  proxy_server: ${proxy}"
		echo "  join_params:"
		echo "    token_name: ${token}"
		echo "    method: token"
		echo "  log:"
		echo "    output: stderr"
		echo "    severity: info"
		if [ "$insecure" = 1 ]; then
			echo "  insecure: yes"
		fi
		echo "ssh_service:"
		echo "  enabled: yes"
		if [ -n "$labels" ]; then
			echo "  labels:"
			for kv in $labels; do
				echo "    ${kv%%=*}: ${kv#*=}"
			done
		fi
		commands_header=0
		config_foreach emit_command command
		echo "edge_service:"
		echo "  memory_limit: 128MiB"
		echo "  max_connections: 8"
	} > "$CONF"
}

start_service() {
	generate_yaml || return 0
	procd_open_instance
	procd_set_param command "$PROG" start --config="$CONF"
	# Unlimited retries: WAN is often down when the agent first starts, and
	# teleport-edge now reconnects in-process, but a crash during prolonged
	# outages must still come back.
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param user root
	procd_close_instance
}

reload_service() {
	stop
	start
}
