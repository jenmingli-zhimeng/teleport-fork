# Copy to .env and edit. Compose reads this file from the same directory.

# Image loaded via `docker load -i ...` (do not pull from docker.io).
TELEPORT_IMAGE=teleport-cluster:18.10.0
TELEPORT_CONTAINER_NAME=teleport
TZ=Asia/Shanghai

# Cluster identity. cluster_name is stored in the backend; changing it later
# requires wiping TELEPORT_DATA_DIR.
TELEPORT_CLUSTER_NAME=teleport.example.com
TELEPORT_NODENAME=teleport

# Public hostname clients and Edge agents use. Must resolve (DNS or /etc/hosts)
# to this host. Combined with TELEPORT_WEB_PORT unless TELEPORT_PUBLIC_ADDR is set.
TELEPORT_PUBLIC_HOST=teleport.example.com

# Host and container listen on the same uncommon port (not 443 / 8443).
TELEPORT_WEB_PORT=27443

# Advertised host:port. Leave empty to use TELEPORT_PUBLIC_HOST:TELEPORT_WEB_PORT.
TELEPORT_PUBLIC_ADDR=

# Auth stays on loopback inside the container. Change only if you also publish it.
TELEPORT_AUTH_LISTEN_ADDR=127.0.0.1:3025

# Host paths — certificates (Let's Encrypt fullchain + privkey).
# Empty placeholder files in ./certs disable file certs (self-signed).
# Example with Nginx Proxy Manager / certbot:
#   TELEPORT_CERT_FILE=/etc/letsencrypt/live/teleport.example.com/fullchain.pem
#   TELEPORT_KEY_FILE=/etc/letsencrypt/live/teleport.example.com/privkey.pem
TELEPORT_CERT_FILE=./certs/fullchain.pem
TELEPORT_KEY_FILE=./certs/privkey.pem
TELEPORT_HTTPS_RELOAD_INTERVAL=1h

# Host paths — Web UI logos (SVG). Empty files keep the logos baked into the image.
TELEPORT_LOGO_LIGHT=./logo/logo-light.svg
TELEPORT_LOGO_DARK=./logo/logo-dark.svg

# Persistent cluster state (CAs, users, tokens). Back this up.
TELEPORT_DATA_DIR=./data

TELEPORT_LOG_LEVEL=info
TELEPORT_SESSION_RECORDING=node-sync
# otp | off  (off also sets TELEPORT_ALLOW_NO_SECOND_FACTOR)
TELEPORT_SECOND_FACTOR=otp
TELEPORT_SSH_ENABLED=no
